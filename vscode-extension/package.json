{
  "name": "codeguardian-review",
  "displayName": "CodeGuardian Git-Native AI Code Review Assistant",
  "description": "Production-grade, Git-native AI pre-commit and pre-push code review assistant with repository-aware AI chat, interactive diffs, and rule enforcement.",
  "version": "0.3.2",
  "publisher": "codeguardian",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Source Control",
    "Linters",
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeguardian-view-container",
          "title": "CodeGuardian Review",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "codeguardian-view-container": [
        {
          "type": "webview",
          "id": "codeguardian.chatView",
          "name": "AI Assistant Chat",
          "icon": "$(comment-discussion)"
        },
        {
          "id": "codeguardian.reviewTree",
          "name": "Git Review Explorer",
          "icon": "$(git-commit)"
        },
        {
          "id": "codeguardian.findingsTree",
          "name": "Active Findings & Suggestions",
          "icon": "$(alert)"
        },
        {
          "id": "codeguardian.historyTree",
          "name": "Review History & Audit",
          "icon": "$(history)"
        }
      ]
    },
    "commands": [
      {
        "command": "codeguardian.openChat",
        "title": "CodeGuardian: Open AI Chat Assistant",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codeguardian.clearChat",
        "title": "CodeGuardian: Clear Chat History",
        "icon": "$(clear-all)"
      },
      {
        "command": "codeguardian.explainSelection",
        "title": "CodeGuardian: Ask AI Chat About Selection",
        "icon": "$(question)"
      },
      {
        "command": "codeguardian.generateTests",
        "title": "CodeGuardian: Generate Unit Tests for Active File",
        "icon": "$(beaker)"
      },
      {
        "command": "codeguardian.analyzeStaged",
        "title": "CodeGuardian: Analyze Pre-Commit (Staged Changes)",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "codeguardian.analyzeLatestCommit",
        "title": "CodeGuardian: Analyze Pre-Push (Unpushed Commits)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "codeguardian.openReviewStudio",
        "title": "CodeGuardian: Open Review Studio",
        "icon": "$(layout)"
      },
      {
        "command": "codeguardian.openReviewReport",
        "title": "CodeGuardian: Open Markdown Review Report",
        "icon": "$(book)"
      },
      {
        "command": "codeguardian.installHooks",
        "title": "CodeGuardian: Install Git Pre-Commit & Pre-Push Hooks",
        "icon": "$(plug)"
      },
      {
        "command": "codeguardian.acceptFinding",
        "title": "Accept Suggestion",
        "icon": "$(check)"
      },
      {
        "command": "codeguardian.rejectFinding",
        "title": "Reject Suggestion",
        "icon": "$(close)"
      },
      {
        "command": "codeguardian.rewriteFinding",
        "title": "Rewrite Fix with AI",
        "icon": "$(edit)"
      },
      {
        "command": "codeguardian.explainFinding",
        "title": "Explain Issue with AI",
        "icon": "$(info)"
      },
      {
        "command": "codeguardian.ignoreFinding",
        "title": "Ignore Finding",
        "icon": "$(eye-closed)"
      },
      {
        "command": "codeguardian.openDiff",
        "title": "Open Diff Review"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeguardian.explainSelection",
          "group": "codeguardian@1"
        },
        {
          "command": "codeguardian.generateTests",
          "group": "codeguardian@2"
        }
      ],
      "view/title": [
        {
          "command": "codeguardian.clearChat",
          "when": "view == codeguardian.chatView",
          "group": "navigation@1"
        },
        {
          "command": "codeguardian.analyzeStaged",
          "when": "view == codeguardian.reviewTree",
          "group": "navigation@1"
        },
        {
          "command": "codeguardian.analyzeLatestCommit",
          "when": "view == codeguardian.reviewTree",
          "group": "navigation@2"
        },
        {
          "command": "codeguardian.openReviewStudio",
          "when": "view == codeguardian.reviewTree",
          "group": "navigation@3"
        },
        {
          "command": "codeguardian.openReviewReport",
          "when": "view == codeguardian.reviewTree",
          "group": "navigation@4"
        },
        {
          "command": "codeguardian.installHooks",
          "when": "view == codeguardian.reviewTree",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "codeguardian.acceptFinding",
          "when": "view == codeguardian.findingsTree && viewItem == findingItem",
          "group": "inline@1"
        },
        {
          "command": "codeguardian.rejectFinding",
          "when": "view == codeguardian.findingsTree && viewItem == findingItem",
          "group": "inline@2"
        },
        {
          "command": "codeguardian.rewriteFinding",
          "when": "view == codeguardian.findingsTree && viewItem == findingItem",
          "group": "inline@3"
        },
        {
          "command": "codeguardian.explainFinding",
          "when": "view == codeguardian.findingsTree && viewItem == findingItem",
          "group": "inline@4"
        },
        {
          "command": "codeguardian.ignoreFinding",
          "when": "view == codeguardian.findingsTree && viewItem == findingItem",
          "group": "inline@5"
        }
      ]
    },
    "configuration": {
      "title": "CodeGuardian",
      "properties": {
        "codeguardian.beBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8010",
          "description": "URL of the standalone CodeGuardian BE analysis sidecar."
        },
        "codeguardian.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional API Key (OpenAI / GenAILab) for full AI chat, code analysis, and AI rewrites."
        },
        "codeguardian.authToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional sidecar token. For terminal pre-push checks, set the `CODEGUARDIAN_BE_TOKEN` environment variable instead."
        },
        "codeguardian.blockCommitOnHighSeverity": {
          "type": "boolean",
          "default": true,
          "description": "Prevent pre-commit when a high or critical security finding is detected in staged changes."
        },
        "codeguardian.blockPushOnHighSeverity": {
          "type": "boolean",
          "default": true,
          "description": "Prevent pre-push when a high or critical finding is detected in unpushed commits."
        },
        "codeguardian.analyzeAfterCommit": {
          "type": "boolean",
          "default": true,
          "description": "Analyze the latest commit whenever Git HEAD changes in the workspace."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.0"
  }
}
